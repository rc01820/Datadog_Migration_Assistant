# Key used to encrypt stored SolarWinds/Datadog credentials.
# If unset, a random key is generated in the data volume (/data/.dma_secret).
# Set it explicitly so credentials survive a volume restore on another host.
DMA_SECRET_KEY=change-me-to-a-long-random-string

DMA_LOG_LEVEL=INFO

# Optional: create the first sign-in account automatically on first start.
# Leave unset to create it in the browser instead (setup page on first visit).
# DMA_ADMIN_USER=admin
# DMA_ADMIN_PASSWORD=change-me-at-least-10-characters

# How long a sign-in lasts, in hours (default 12).
# DMA_SESSION_HOURS=12

# Optional: SAM component type IDs that are HTTP/HTTPS monitors in your Orion.
# Confirm with SWQL first (see README, "HTTP and HTTPS monitor templates").
# DMA_SAM_HTTP_COMPONENT_TYPES=6,14
# DMA_SAM_PROCESS_COMPONENT_TYPES=9,10
